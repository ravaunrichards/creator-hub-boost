PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creator_hub_boost

# Use a unique random secret with at least 32 characters in production.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-use

# PayPal Developer REST app credentials. Keep SANDBOX until checkout has been tested.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

# Admin access uses this email and a bcrypt password hash; never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
